# Copy to .env.local and fill in. Never commit real values.
AMD_TOKENFACTORY_APIKEY=
AMD_TOKENFACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Evolus knowledge library (RAG over manuals and closed interventions); optional, local fallback
EVOLUS_SPACE_APIKEY=
EVOLUS_BASE_URL=https://api.evolus.ai
EVOLUS_APPLICATION_ID=
EVOLUS_MEMORY_ID=
EVOLUS_MEMORY_AGENT_ID=
# "1" to serve recorded LLM responses instead of calling the API
REPLAY_MODE=0
# "1" (local dev only) to record LLM responses into data/replay/
RECORD_MODE=0
